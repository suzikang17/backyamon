# Copy to .env on the VPS and fill in. Used by docker-compose (both services).
# Do NOT commit the real .env.

# ── Server (apps/server) ──────────────────────────────────────────────
PORT=3001

# CORS allowlist of web origins (comma-separated, no spaces). Same-origin in the
# consolidated setup, but list all hostnames the browser may load from.
WEB_URL=https://backyamon.com,https://www.backyamon.com

# Database — Turso (managed libSQL). Leave both unset to use a local sqlite file
# (file:backyamon.db), in which case add the volume in docker-compose.yml.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Asset storage — Cloudflare R2 (S3-compatible)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=backyamon-assets

# ── Web (apps/web) ────────────────────────────────────────────────────
# NOTE: NEXT_PUBLIC_SERVER_URL is baked in at BUILD time via the build arg in
# docker-compose.yml (default https://backyamon.com), NOT read from this file at
# runtime. Change it there if the frontend should talk to a different origin.
